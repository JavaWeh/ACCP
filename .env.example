# Documentation only: use scripts/dev-env.mjs to generate random local credentials.
POSTGRES_PASSWORD=replace-with-a-random-password
ACCP_ENV=production
ACCP_AUTH_MODE=oidc
ACCP_OIDC_ISSUER=https://identity.example.com
ACCP_OIDC_AUDIENCE=accp-api
ACCP_HTTP_PORT=8080
# Persistent signing key: 32 random bytes as 64 hex characters; never commit a real key.
ACCP_SESSION_KEY=replace-with-random-64-hex-characters
ACCP_PUBLIC_URL=https://accp.example.com
ACCP_NATS_TOKEN=replace-with-a-random-nats-token
