FROM golang:1.27.1@sha256:f44f6e88636cfb311f9ebace870ded69d943f227bb3cb27d32ffd84ea18c43ea AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY cmd/accp-ops ./cmd/accp-ops
COPY internal/recovery ./internal/recovery
RUN CGO_ENABLED=0 go build -trimpath -ldflags='-s -w' -o /accp-ops ./cmd/accp-ops
FROM postgres:17@sha256:67f41722b7a8cbdb868a44a4995c846eddfdc2973bccb291ce937dce88ad5675
COPY --from=build /accp-ops /usr/local/bin/accp-ops
USER 65532:65532
ENTRYPOINT ["/usr/local/bin/accp-ops"]
