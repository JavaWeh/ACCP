{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://accp.example/schemas/v0.1/m1.schema.json",
  "title": "M1 foundation extensions",
  "$defs": {
    "UploadContent": {
      "type": "object",
      "properties": {
        "content": {
          "type": "string",
          "minLength": 1,
          "maxLength": 262144
        },
        "media_type": {
          "type": "string",
          "enum": [
            "text/plain",
            "text/markdown",
            "application/json",
            "application/yaml"
          ]
        }
      },
      "required": [
        "content",
        "media_type"
      ],
      "additionalProperties": false
    },
    "MembershipChange": {
      "type": "object",
      "properties": {
        "roles": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "ADMIN",
              "MEMBER",
              "REVIEWER",
              "VIEWER"
            ]
          }
        },
        "active": {
          "type": "boolean"
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        }
      },
      "required": [
        "roles",
        "active"
      ],
      "additionalProperties": false
    },
    "Human": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-zA-Z][a-zA-Z0-9_.:-]{1,127}$"
        },
        "organization_id": {
          "type": "string",
          "pattern": "^[a-zA-Z][a-zA-Z0-9_.:-]{1,127}$"
        },
        "display_name": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "const": "HUMAN"
        },
        "is_org_admin": {
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "organization_id",
        "display_name",
        "kind",
        "is_org_admin"
      ],
      "additionalProperties": false
    },
    "Project": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-zA-Z][a-zA-Z0-9_.:-]{1,127}$"
        },
        "organization_id": {
          "type": "string",
          "pattern": "^[a-zA-Z][a-zA-Z0-9_.:-]{1,127}$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "roles": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "ADMIN",
              "MEMBER",
              "REVIEWER",
              "VIEWER"
            ]
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "status": {
          "enum": [
            "ACTIVE",
            "ARCHIVED"
          ]
        },
        "version": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "id",
        "organization_id",
        "name",
        "roles"
      ],
      "additionalProperties": false
    },
    "Membership": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-zA-Z][a-zA-Z0-9_.:-]{1,127}$"
        },
        "organization_id": {
          "type": "string",
          "pattern": "^[a-zA-Z][a-zA-Z0-9_.:-]{1,127}$"
        },
        "project_id": {
          "type": "string",
          "pattern": "^[a-zA-Z][a-zA-Z0-9_.:-]{1,127}$"
        },
        "display_name": {
          "type": "string",
          "minLength": 1
        },
        "roles": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "ADMIN",
              "MEMBER",
              "REVIEWER",
              "VIEWER"
            ]
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "membership_active": {
          "type": "boolean",
          "description": "Whether this project membership is active."
        },
        "account_active": {
          "type": "boolean",
          "description": "Whether the human account is active organization-wide."
        },
        "active": {
          "type": "boolean",
          "description": "Effective access for this project: membership_active AND account_active. Prefer the split fields for UI."
        },
        "version": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "id",
        "organization_id",
        "project_id",
        "display_name",
        "roles",
        "membership_active",
        "account_active",
        "active",
        "version"
      ],
      "additionalProperties": false
    },
    "ContentMetadata": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-zA-Z][a-zA-Z0-9_.:-]{1,127}$"
        },
        "organization_id": {
          "type": "string",
          "pattern": "^[a-zA-Z][a-zA-Z0-9_.:-]{1,127}$"
        },
        "project_id": {
          "type": "string",
          "pattern": "^[a-zA-Z][a-zA-Z0-9_.:-]{1,127}$"
        },
        "content_uri": {
          "type": "string",
          "format": "uri",
          "pattern": "^urn:accp:content:"
        },
        "content_digest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "media_type": {
          "type": "string",
          "enum": [
            "text/plain",
            "text/markdown",
            "application/json",
            "application/yaml"
          ]
        }
      },
      "required": [
        "id",
        "organization_id",
        "project_id",
        "content_uri",
        "content_digest",
        "media_type"
      ],
      "additionalProperties": false
    },
    "Content": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-zA-Z][a-zA-Z0-9_.:-]{1,127}$"
        },
        "organization_id": {
          "type": "string",
          "pattern": "^[a-zA-Z][a-zA-Z0-9_.:-]{1,127}$"
        },
        "project_id": {
          "type": "string",
          "pattern": "^[a-zA-Z][a-zA-Z0-9_.:-]{1,127}$"
        },
        "content_uri": {
          "type": "string",
          "format": "uri",
          "pattern": "^urn:accp:content:"
        },
        "content_digest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "media_type": {
          "type": "string",
          "enum": [
            "text/plain",
            "text/markdown",
            "application/json",
            "application/yaml"
          ]
        },
        "content": {
          "type": "string",
          "minLength": 1,
          "maxLength": 262144
        }
      },
      "required": [
        "id",
        "organization_id",
        "project_id",
        "content_uri",
        "content_digest",
        "media_type",
        "content"
      ],
      "additionalProperties": false
    },
    "ProjectPage": {
      "type": "object",
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Project"
          }
        },
        "next_cursor": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "items",
        "next_cursor"
      ],
      "additionalProperties": false
    },
    "MembershipPage": {
      "type": "object",
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Membership"
          }
        },
        "next_cursor": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "items",
        "next_cursor"
      ],
      "additionalProperties": false
    },
    "ContextVersionPage": {
      "type": "object",
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "$ref": "./domain.schema.json#/$defs/ContextVersion"
          }
        },
        "next_cursor": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "items",
        "next_cursor"
      ],
      "additionalProperties": false
    },
    "WorkTaskItem": {
      "type": "object",
      "properties": {
        "project_id": {
          "type": "string",
          "pattern": "^[a-zA-Z][a-zA-Z0-9_.:-]{1,127}$"
        },
        "project_name": {
          "type": "string",
          "minLength": 1
        },
        "task_id": {
          "type": "string",
          "pattern": "^[a-zA-Z][a-zA-Z0-9_.:-]{1,127}$"
        },
        "title": {
          "type": "string"
        },
        "status": {
          "enum": [
            "IN_REVIEW",
            "BLOCKED",
            "FAILED"
          ]
        },
        "waiting_since": {
          "type": "string"
        }
      },
      "required": [
        "project_id",
        "project_name",
        "task_id",
        "title",
        "status",
        "waiting_since"
      ],
      "additionalProperties": false
    },
    "WorkApprovalItem": {
      "type": "object",
      "properties": {
        "project_id": {
          "type": "string",
          "pattern": "^[a-zA-Z][a-zA-Z0-9_.:-]{1,127}$"
        },
        "project_name": {
          "type": "string",
          "minLength": 1
        },
        "approval_id": {
          "type": "string",
          "pattern": "^[a-zA-Z][a-zA-Z0-9_.:-]{1,127}$"
        },
        "invocation_id": {
          "type": "string",
          "pattern": "^[a-zA-Z][a-zA-Z0-9_.:-]{1,127}$"
        },
        "task_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "title": {
          "type": "string"
        },
        "waiting_since": {
          "type": "string"
        }
      },
      "required": [
        "project_id",
        "project_name",
        "approval_id",
        "invocation_id",
        "task_id",
        "title",
        "waiting_since"
      ],
      "additionalProperties": false
    },
    "WorkTaskGroup": {
      "type": "object",
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/WorkTaskItem"
          }
        }
      },
      "required": [
        "items"
      ],
      "additionalProperties": false
    },
    "WorkApprovalGroup": {
      "type": "object",
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/WorkApprovalItem"
          }
        }
      },
      "required": [
        "items"
      ],
      "additionalProperties": false
    },
    "WorkQueue": {
      "type": "object",
      "properties": {
        "groups": {
          "type": "object",
          "properties": {
            "review": {
              "$ref": "#/$defs/WorkTaskGroup"
            },
            "approval": {
              "$ref": "#/$defs/WorkApprovalGroup"
            },
            "blocked": {
              "$ref": "#/$defs/WorkTaskGroup"
            }
          },
          "required": [
            "review",
            "approval",
            "blocked"
          ],
          "additionalProperties": false
        },
        "checked_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "groups",
        "checked_at"
      ],
      "additionalProperties": false
    }
  }
}
