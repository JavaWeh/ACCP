{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://accp.example/schemas/v0.2/m2.schema.json",
  "title": "ACCP v0.2 execution contracts",
  "$defs": {
    "Capabilities": {
      "type": "object",
      "properties": {
        "claim": {
          "const": true
        },
        "context_read": {
          "const": true
        },
        "artifact_report": {
          "const": true
        },
        "heartbeat": {
          "const": true
        },
        "cancel": {
          "type": "string",
          "enum": [
            "cooperative",
            "process"
          ]
        },
        "notifications": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "poll",
              "sse"
            ]
          },
          "minItems": 1,
          "uniqueItems": true,
          "contains": {
            "const": "poll"
          }
        },
        "auto_start": {
          "type": "boolean"
        }
      },
      "required": [
        "claim",
        "context_read",
        "artifact_report",
        "heartbeat",
        "cancel",
        "notifications",
        "auto_start"
      ],
      "additionalProperties": false
    },
    "Manifest": {
      "type": "object",
      "properties": {
        "adapter_id": {
          "type": "string",
          "pattern": "^[a-zA-Z][a-zA-Z0-9_.:-]{1,127}$"
        },
        "adapter_version": {
          "type": "string",
          "minLength": 1
        },
        "protocol_versions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 32
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "client": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1
            },
            "version": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "name",
            "version"
          ],
          "additionalProperties": false
        },
        "capabilities": {
          "$ref": "#/$defs/Capabilities"
        },
        "extensions": {
          "type": "object",
          "propertyNames": {
            "pattern": "^[a-z][a-z0-9.-]+/[a-zA-Z0-9_.-]+$"
          },
          "additionalProperties": true
        }
      },
      "required": [
        "adapter_id",
        "adapter_version",
        "protocol_versions",
        "client",
        "capabilities"
      ],
      "additionalProperties": false
    },
    "HandshakeRequest": {
      "type": "object",
      "properties": {
        "manifest": {
          "$ref": "#/$defs/Manifest"
        }
      },
      "required": [
        "manifest"
      ],
      "additionalProperties": false
    },
    "HandshakeResponse": {
      "type": "object",
      "properties": {
        "protocol_version": {
          "const": "0.2"
        },
        "accepted_capabilities": {
          "$ref": "#/$defs/Capabilities"
        },
        "api_base_uri": {
          "type": "string",
          "format": "uri"
        },
        "mcp_uri": {
          "type": "string",
          "format": "uri"
        }
      },
      "required": [
        "protocol_version",
        "accepted_capabilities",
        "api_base_uri"
      ],
      "additionalProperties": false
    },
    "AgentRegistration": {
      "type": "object",
      "properties": {
        "project_id": {
          "type": "string",
          "pattern": "^[a-zA-Z][a-zA-Z0-9_.:-]{1,127}$"
        },
        "manifest": {
          "$ref": "#/$defs/Manifest"
        }
      },
      "required": [
        "project_id",
        "manifest"
      ],
      "additionalProperties": false
    },
    "ClaimRequest": {
      "type": "object",
      "properties": {
        "project_id": {
          "type": "string",
          "pattern": "^[a-zA-Z][a-zA-Z0-9_.:-]{1,127}$"
        },
        "base_revision": {
          "type": "string",
          "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$"
        },
        "task_id": {
          "type": "string",
          "pattern": "^[a-zA-Z][a-zA-Z0-9_.:-]{1,127}$"
        }
      },
      "required": [
        "project_id",
        "base_revision"
      ],
      "additionalProperties": false
    },
    "Event": {
      "oneOf": [
        {
          "$ref": "https://accp.example/schemas/v0.1/event.schema.json"
        },
        {
          "title": "TASK_CANCELED",
          "type": "object",
          "properties": {
            "specversion": {
              "const": "1.0"
            },
            "id": {
              "type": "string",
              "pattern": "^[a-zA-Z][a-zA-Z0-9_.:-]{1,127}$"
            },
            "source": {
              "type": "string",
              "const": "urn:accp:control-plane"
            },
            "type": {
              "const": "io.accp.TASK_CANCELED.v1"
            },
            "subject": {
              "type": "string",
              "minLength": 1
            },
            "time": {
              "type": "string",
              "format": "date-time"
            },
            "datacontenttype": {
              "const": "application/json"
            },
            "traceparent": {
              "type": "string",
              "pattern": "^[0-9a-f]{2}-[0-9a-f]{32}-[0-9a-f]{16}-[0-9a-f]{2}$"
            },
            "data": {
              "type": "object",
              "properties": {
                "organization_id": {
                  "type": "string",
                  "pattern": "^[a-zA-Z][a-zA-Z0-9_.:-]{1,127}$"
                },
                "project_id": {
                  "type": "string",
                  "pattern": "^[a-zA-Z][a-zA-Z0-9_.:-]{1,127}$"
                },
                "aggregate_id": {
                  "type": "string",
                  "pattern": "^[a-zA-Z][a-zA-Z0-9_.:-]{1,127}$"
                },
                "aggregate_version": {
                  "type": "integer",
                  "minimum": 1
                },
                "correlation_id": {
                  "type": "string",
                  "pattern": "^[a-zA-Z][a-zA-Z0-9_.:-]{1,127}$"
                },
                "causation_id": {
                  "type": "string",
                  "pattern": "^[a-zA-Z][a-zA-Z0-9_.:-]{1,127}$"
                },
                "task_id": {
                  "type": "string",
                  "pattern": "^[a-zA-Z][a-zA-Z0-9_.:-]{1,127}$"
                },
                "canceled_by_user_id": {
                  "type": "string",
                  "pattern": "^[a-zA-Z][a-zA-Z0-9_.:-]{1,127}$"
                }
              },
              "required": [
                "organization_id",
                "project_id",
                "aggregate_id",
                "aggregate_version",
                "correlation_id",
                "causation_id",
                "task_id",
                "canceled_by_user_id"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "specversion",
            "id",
            "source",
            "type",
            "subject",
            "time",
            "datacontenttype",
            "data"
          ],
          "additionalProperties": false
        },
        {
          "title": "SESSION_REVOKED",
          "type": "object",
          "properties": {
            "specversion": {
              "const": "1.0"
            },
            "id": {
              "type": "string",
              "pattern": "^[a-zA-Z][a-zA-Z0-9_.:-]{1,127}$"
            },
            "source": {
              "type": "string",
              "const": "urn:accp:control-plane"
            },
            "type": {
              "const": "io.accp.SESSION_REVOKED.v1"
            },
            "subject": {
              "type": "string",
              "minLength": 1
            },
            "time": {
              "type": "string",
              "format": "date-time"
            },
            "datacontenttype": {
              "const": "application/json"
            },
            "traceparent": {
              "type": "string",
              "pattern": "^[0-9a-f]{2}-[0-9a-f]{32}-[0-9a-f]{16}-[0-9a-f]{2}$"
            },
            "data": {
              "type": "object",
              "properties": {
                "organization_id": {
                  "type": "string",
                  "pattern": "^[a-zA-Z][a-zA-Z0-9_.:-]{1,127}$"
                },
                "project_id": {
                  "type": "string",
                  "pattern": "^[a-zA-Z][a-zA-Z0-9_.:-]{1,127}$"
                },
                "aggregate_id": {
                  "type": "string",
                  "pattern": "^[a-zA-Z][a-zA-Z0-9_.:-]{1,127}$"
                },
                "aggregate_version": {
                  "type": "integer",
                  "minimum": 1
                },
                "correlation_id": {
                  "type": "string",
                  "pattern": "^[a-zA-Z][a-zA-Z0-9_.:-]{1,127}$"
                },
                "causation_id": {
                  "type": "string",
                  "pattern": "^[a-zA-Z][a-zA-Z0-9_.:-]{1,127}$"
                },
                "session_id": {
                  "type": "string",
                  "pattern": "^[a-zA-Z][a-zA-Z0-9_.:-]{1,127}$"
                },
                "revoked_by_user_id": {
                  "type": "string",
                  "pattern": "^[a-zA-Z][a-zA-Z0-9_.:-]{1,127}$"
                }
              },
              "required": [
                "organization_id",
                "project_id",
                "aggregate_id",
                "aggregate_version",
                "correlation_id",
                "causation_id",
                "session_id",
                "revoked_by_user_id"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "specversion",
            "id",
            "source",
            "type",
            "subject",
            "time",
            "datacontenttype",
            "data"
          ],
          "additionalProperties": false
        }
      ]
    },
    "EventPage": {
      "type": "object",
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Event"
          }
        },
        "next_cursor": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "items",
        "next_cursor"
      ],
      "additionalProperties": false
    },
    "ArtifactContent": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-zA-Z][a-zA-Z0-9_.:-]{1,127}$"
        },
        "project_id": {
          "type": "string",
          "pattern": "^[a-zA-Z][a-zA-Z0-9_.:-]{1,127}$"
        },
        "organization_id": {
          "type": "string",
          "pattern": "^[a-zA-Z][a-zA-Z0-9_.:-]{1,127}$"
        },
        "run_id": {
          "type": "string",
          "pattern": "^[a-zA-Z][a-zA-Z0-9_.:-]{1,127}$"
        },
        "uri": {
          "type": "string",
          "format": "uri"
        },
        "content_digest": {
          "$ref": "https://accp.example/schemas/v0.1/domain.schema.json#/$defs/Digest"
        },
        "media_type": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "id",
        "project_id",
        "organization_id",
        "run_id",
        "uri",
        "content_digest",
        "media_type"
      ],
      "additionalProperties": false
    },
    "AgentIdentityPage": {
      "type": "object",
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "$ref": "https://accp.example/schemas/v0.1/domain.schema.json#/$defs/AgentIdentity"
          }
        },
        "next_cursor": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "items",
        "next_cursor"
      ],
      "additionalProperties": false
    },
    "AgentSessionPage": {
      "type": "object",
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "$ref": "https://accp.example/schemas/v0.1/domain.schema.json#/$defs/AgentSession"
          }
        },
        "next_cursor": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "items",
        "next_cursor"
      ],
      "additionalProperties": false
    },
    "TaskRunPage": {
      "type": "object",
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "$ref": "https://accp.example/schemas/v0.1/domain.schema.json#/$defs/TaskRun"
          }
        },
        "next_cursor": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "items",
        "next_cursor"
      ],
      "additionalProperties": false
    },
    "TaskDependencyPage": {
      "type": "object",
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "$ref": "https://accp.example/schemas/v0.1/domain.schema.json#/$defs/TaskDependency"
          }
        },
        "next_cursor": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "items",
        "next_cursor"
      ],
      "additionalProperties": false
    },
    "ArtifactPage": {
      "type": "object",
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "$ref": "https://accp.example/schemas/v0.1/domain.schema.json#/$defs/Artifact"
          }
        },
        "next_cursor": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "items",
        "next_cursor"
      ],
      "additionalProperties": false
    },
    "AssignmentPage": {
      "type": "object",
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "$ref": "https://accp.example/schemas/v0.1/domain.schema.json#/$defs/Assignment"
          }
        },
        "next_cursor": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "items",
        "next_cursor"
      ],
      "additionalProperties": false
    },
    "ArtifactContentBody": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-zA-Z][a-zA-Z0-9_.:-]{1,127}$"
        },
        "project_id": {
          "type": "string",
          "pattern": "^[a-zA-Z][a-zA-Z0-9_.:-]{1,127}$"
        },
        "organization_id": {
          "type": "string",
          "pattern": "^[a-zA-Z][a-zA-Z0-9_.:-]{1,127}$"
        },
        "run_id": {
          "type": "string",
          "pattern": "^[a-zA-Z][a-zA-Z0-9_.:-]{1,127}$"
        },
        "uri": {
          "type": "string",
          "format": "uri"
        },
        "content_digest": {
          "$ref": "https://accp.example/schemas/v0.1/domain.schema.json#/$defs/Digest"
        },
        "media_type": {
          "type": "string",
          "minLength": 1
        },
        "content": {
          "type": "string",
          "maxLength": 262144
        }
      },
      "required": [
        "id",
        "project_id",
        "organization_id",
        "run_id",
        "uri",
        "content_digest",
        "media_type",
        "content"
      ],
      "additionalProperties": false
    },
    "ReplayReceipt": {
      "type": "object",
      "properties": {
        "event_id": {
          "type": "string",
          "pattern": "^[a-zA-Z][a-zA-Z0-9_.:-]{1,127}$"
        },
        "status": {
          "const": "REPLAY_QUEUED"
        }
      },
      "required": [
        "event_id",
        "status"
      ],
      "additionalProperties": false
    },
    "RunReportRecord": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-zA-Z][a-zA-Z0-9_.:-]{1,127}$"
        },
        "run_id": {
          "type": "string",
          "pattern": "^[a-zA-Z][a-zA-Z0-9_.:-]{1,127}$"
        },
        "project_id": {
          "type": "string",
          "pattern": "^[a-zA-Z][a-zA-Z0-9_.:-]{1,127}$"
        },
        "organization_id": {
          "type": "string",
          "pattern": "^[a-zA-Z][a-zA-Z0-9_.:-]{1,127}$"
        },
        "report": {
          "$ref": "https://accp.example/schemas/v0.1/domain.schema.json#/$defs/RunReport"
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "run_id",
        "project_id",
        "organization_id",
        "report",
        "created_at"
      ],
      "additionalProperties": false
    },
    "RunReportPage": {
      "type": "object",
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/RunReportRecord"
          }
        },
        "next_cursor": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "items",
        "next_cursor"
      ],
      "additionalProperties": false
    }
  }
}
