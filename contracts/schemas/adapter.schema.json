{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://accp.example/schemas/v0.1/adapter.schema.json",
  "title": "ACCP adapter contracts v0.1",
  "$defs": {
    "Capabilities": {
      "type": "object",
      "properties": {
        "claim": {
          "const": true
        },
        "context_read": {
          "const": true
        },
        "artifact_report": {
          "const": true
        },
        "heartbeat": {
          "const": true
        },
        "cancel": {
          "type": "string",
          "enum": [
            "cooperative",
            "process"
          ]
        },
        "notifications": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "poll",
              "sse"
            ]
          },
          "minItems": 1,
          "uniqueItems": true,
          "contains": {
            "const": "poll"
          }
        },
        "auto_start": {
          "type": "boolean"
        }
      },
      "required": [
        "claim",
        "context_read",
        "artifact_report",
        "heartbeat",
        "cancel",
        "notifications",
        "auto_start"
      ],
      "additionalProperties": false
    },
    "Manifest": {
      "type": "object",
      "properties": {
        "adapter_id": {
          "type": "string",
          "pattern": "^[a-zA-Z][a-zA-Z0-9_.:-]{1,127}$"
        },
        "adapter_version": {
          "type": "string",
          "minLength": 1
        },
        "protocol_versions": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "0.1"
            ]
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "client": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1
            },
            "version": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "name",
            "version"
          ],
          "additionalProperties": false
        },
        "capabilities": {
          "$ref": "#/$defs/Capabilities"
        },
        "extensions": {
          "type": "object",
          "propertyNames": {
            "pattern": "^[a-z][a-z0-9.-]+/[a-zA-Z0-9_.-]+$"
          },
          "additionalProperties": true
        }
      },
      "required": [
        "adapter_id",
        "adapter_version",
        "protocol_versions",
        "client",
        "capabilities"
      ],
      "additionalProperties": false
    },
    "HandshakeRequest": {
      "type": "object",
      "properties": {
        "manifest": {
          "$ref": "#/$defs/Manifest"
        }
      },
      "required": [
        "manifest"
      ],
      "additionalProperties": false
    },
    "HandshakeResponse": {
      "type": "object",
      "properties": {
        "protocol_version": {
          "const": "0.1"
        },
        "accepted_capabilities": {
          "$ref": "#/$defs/Capabilities"
        },
        "api_base_uri": {
          "type": "string",
          "format": "uri"
        },
        "mcp_uri": {
          "type": "string",
          "format": "uri"
        }
      },
      "required": [
        "protocol_version",
        "accepted_capabilities",
        "api_base_uri",
        "mcp_uri"
      ],
      "additionalProperties": false
    }
  }
}
