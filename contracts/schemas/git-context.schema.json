{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://accp.example/schemas/v0.5/git-context.schema.json",
  "$defs": {
    "Create": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "type": {
          "type": "string",
          "enum": [
            "REQUIREMENT",
            "API",
            "DB_SCHEMA",
            "ADR",
            "PROJECT_STANDARD"
          ]
        },
        "repository_id": {
          "type": "string",
          "pattern": "^[a-zA-Z][a-zA-Z0-9_.:-]{1,127}$"
        },
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        }
      },
      "required": [
        "name",
        "type",
        "repository_id",
        "path",
        "ref",
        "reason"
      ],
      "additionalProperties": false
    },
    "Sync": {
      "type": "object",
      "properties": {
        "ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        }
      },
      "required": [
        "reason"
      ],
      "additionalProperties": false
    },
    "Source": {
      "type": "object",
      "properties": {
        "repository_id": {
          "type": "string",
          "pattern": "^[a-zA-Z][a-zA-Z0-9_.:-]{1,127}$"
        },
        "repository_url": {
          "type": "string",
          "format": "uri"
        },
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        }
      },
      "required": [
        "repository_id",
        "repository_url",
        "path",
        "ref"
      ],
      "additionalProperties": false
    },
    "Provenance": {
      "type": "object",
      "properties": {
        "kind": {
          "const": "GIT"
        },
        "repository_id": {
          "type": "string",
          "pattern": "^[a-zA-Z][a-zA-Z0-9_.:-]{1,127}$"
        },
        "repository_url": {
          "type": "string",
          "format": "uri"
        },
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "commit_sha": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "blob_sha": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "content_digest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        }
      },
      "required": [
        "kind",
        "repository_id",
        "repository_url",
        "path",
        "ref",
        "commit_sha",
        "blob_sha",
        "content_digest"
      ],
      "additionalProperties": false
    },
    "Diff": {
      "type": "object",
      "properties": {
        "before": {
          "type": "string"
        },
        "after": {
          "type": "string"
        },
        "base_version": {
          "anyOf": [
            {
              "$ref": "https://accp.example/schemas/v0.1/domain.schema.json#/$defs/ContextVersion"
            },
            {
              "type": "null"
            }
          ]
        },
        "candidate_version": {
          "$ref": "https://accp.example/schemas/v0.1/domain.schema.json#/$defs/ContextVersion"
        }
      },
      "required": [
        "before",
        "after",
        "base_version",
        "candidate_version"
      ],
      "additionalProperties": false
    }
  }
}
