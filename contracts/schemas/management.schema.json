{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://accp.example/schemas/v0.4/management.schema.json",
  "title": "Enterprise administration",
  "$defs": {
    "CreateProject": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        }
      },
      "required": [
        "name"
      ],
      "additionalProperties": false
    },
    "ProjectChange": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        }
      },
      "required": [
        "name",
        "reason"
      ],
      "additionalProperties": false
    },
    "ProjectCommand": {
      "type": "object",
      "properties": {
        "command": {
          "enum": [
            "ARCHIVE",
            "RESTORE"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        }
      },
      "required": [
        "command",
        "reason"
      ],
      "additionalProperties": false
    },
    "RegisterHuman": {
      "type": "object",
      "properties": {
        "issuer": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "subject": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        },
        "display_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        }
      },
      "required": [
        "issuer",
        "subject",
        "display_name",
        "reason"
      ],
      "additionalProperties": false
    },
    "AddMember": {
      "type": "object",
      "properties": {
        "user_id": {
          "type": "string",
          "pattern": "^[a-zA-Z][a-zA-Z0-9_.:-]{1,127}$"
        },
        "roles": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "ADMIN",
              "MEMBER",
              "REVIEWER",
              "VIEWER"
            ]
          }
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        }
      },
      "required": [
        "user_id",
        "roles",
        "reason"
      ],
      "additionalProperties": false
    },
    "RegisterRepository": {
      "type": "object",
      "properties": {
        "url": {
          "type": "string",
          "format": "uri",
          "maxLength": 2048
        },
        "default_branch": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        }
      },
      "required": [
        "url",
        "default_branch",
        "reason"
      ],
      "additionalProperties": false
    },
    "Project": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-zA-Z][a-zA-Z0-9_.:-]{1,127}$"
        },
        "organization_id": {
          "type": "string",
          "pattern": "^[a-zA-Z][a-zA-Z0-9_.:-]{1,127}$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "status": {
          "enum": [
            "ACTIVE",
            "ARCHIVED"
          ]
        },
        "version": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "id",
        "organization_id",
        "name",
        "status",
        "version"
      ],
      "additionalProperties": false
    },
    "Human": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-zA-Z][a-zA-Z0-9_.:-]{1,127}$"
        },
        "organization_id": {
          "type": "string",
          "pattern": "^[a-zA-Z][a-zA-Z0-9_.:-]{1,127}$"
        },
        "display_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "active": {
          "type": "boolean"
        },
        "kind": {
          "const": "HUMAN"
        }
      },
      "required": [
        "id",
        "organization_id",
        "display_name",
        "active",
        "kind"
      ],
      "additionalProperties": false
    },
    "AuditRecord": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-zA-Z][a-zA-Z0-9_.:-]{1,127}$"
        },
        "organization_id": {
          "type": "string",
          "pattern": "^[a-zA-Z][a-zA-Z0-9_.:-]{1,127}$"
        },
        "actor_id": {
          "type": "string",
          "pattern": "^[a-zA-Z][a-zA-Z0-9_.:-]{1,127}$"
        },
        "action": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "resource_id": {
          "type": "string",
          "pattern": "^[a-zA-Z][a-zA-Z0-9_.:-]{1,127}$"
        },
        "result": {
          "enum": [
            "SUCCEEDED",
            "DENIED"
          ]
        },
        "reason": {
          "type": "string"
        },
        "trace_id": {
          "type": "string",
          "pattern": "^[a-zA-Z][a-zA-Z0-9_.:-]{1,127}$"
        },
        "recorded_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "organization_id",
        "actor_id",
        "action",
        "resource_id",
        "result",
        "reason",
        "trace_id",
        "recorded_at"
      ],
      "additionalProperties": false
    },
    "AuditPage": {
      "type": "object",
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/AuditRecord"
          }
        },
        "next_cursor": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "items"
      ],
      "additionalProperties": false
    },
    "HumanPage": {
      "type": "object",
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Human"
          }
        },
        "next_cursor": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "items"
      ],
      "additionalProperties": false
    }
  }
}
