{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://accp.example/schemas/v0.5/lifecycle.schema.json",
  "title": "Human task lifecycle",
  "$defs": {
    "Edit": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "objective": {
          "type": "string",
          "minLength": 1
        },
        "acceptance_criteria": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000,
          "pattern": "\\S"
        }
      },
      "required": [
        "title",
        "objective",
        "acceptance_criteria",
        "reason"
      ],
      "additionalProperties": false
    },
    "Transfer": {
      "type": "object",
      "properties": {
        "owner_user_id": {
          "type": "string",
          "pattern": "^[a-zA-Z][a-zA-Z0-9_.:-]{1,127}$"
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000,
          "pattern": "\\S"
        }
      },
      "required": [
        "owner_user_id",
        "reason"
      ],
      "additionalProperties": false
    },
    "Inputs": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "objective": {
          "type": "string",
          "minLength": 1
        },
        "acceptance_criteria": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000,
          "pattern": "\\S"
        },
        "repository_id": {
          "type": "string",
          "pattern": "^[a-zA-Z][a-zA-Z0-9_.:-]{1,127}$"
        },
        "context_version_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-zA-Z][a-zA-Z0-9_.:-]{1,127}$"
          },
          "minItems": 1,
          "uniqueItems": true
        }
      },
      "required": [
        "title",
        "objective",
        "acceptance_criteria",
        "reason",
        "repository_id",
        "context_version_ids"
      ],
      "additionalProperties": false
    },
    "Reason": {
      "type": "object",
      "properties": {
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000,
          "pattern": "\\S"
        }
      },
      "required": [
        "reason"
      ],
      "additionalProperties": false
    },
    "Change": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-zA-Z][a-zA-Z0-9_.:-]{1,127}$"
        },
        "project_id": {
          "type": "string",
          "pattern": "^[a-zA-Z][a-zA-Z0-9_.:-]{1,127}$"
        },
        "organization_id": {
          "type": "string",
          "pattern": "^[a-zA-Z][a-zA-Z0-9_.:-]{1,127}$"
        },
        "task_id": {
          "type": "string",
          "pattern": "^[a-zA-Z][a-zA-Z0-9_.:-]{1,127}$"
        },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "action": {
          "enum": [
            "changes",
            "inputs",
            "owner-transfers",
            "archive",
            "restore"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000,
          "pattern": "\\S"
        },
        "actor_user_id": {
          "type": "string",
          "pattern": "^[a-zA-Z][a-zA-Z0-9_.:-]{1,127}$"
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "before": {
          "$ref": "https://accp.example/schemas/v0.1/domain.schema.json#/$defs/Task"
        },
        "after": {
          "$ref": "https://accp.example/schemas/v0.1/domain.schema.json#/$defs/Task"
        }
      },
      "required": [
        "id",
        "project_id",
        "organization_id",
        "task_id",
        "version",
        "action",
        "reason",
        "actor_user_id",
        "created_at",
        "before",
        "after"
      ],
      "additionalProperties": false
    },
    "ChangePage": {
      "type": "object",
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Change"
          }
        },
        "next_cursor": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "items"
      ],
      "additionalProperties": false
    }
  }
}
